# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and replace with your actual credentials.
# On Streamlit Community Cloud, enter these keys in the App Settings > Secrets panel.

# ==============================================================================
# 1. NEO4J AURA DATABASE CONFIGURATION
# ==============================================================================
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "your-neo4j-aura-password-here"
NEO4J_DATABASE = "neo4j"

# ==============================================================================
# 2. GOOGLE OAUTH 2.0 AUTHENTICATION
# ==============================================================================
# In Google Cloud Console > APIs & Services > Credentials:
# Create OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:8501 (or your production deployment URL)
GOOGLE_CLIENT_ID = "your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-google-client-secret"
AUTH_REDIRECT_URI = "http://localhost:8501"

# ==============================================================================
# 3. SUPABASE CLOUD AUTHENTICATION (OPTIONAL - LOCAL ENCRYPTED AUTH ACTIVE BY DEFAULT)
# ==============================================================================
# If configured, SkillGraph AI can also use Supabase Auth for cloud login.
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-supabase-anon-public-key"
